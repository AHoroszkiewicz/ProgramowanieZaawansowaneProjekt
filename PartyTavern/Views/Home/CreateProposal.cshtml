@model PartyTavern.Models.GameProposal

@{
    ViewData["Title"] = "Zaproponuj grę";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="CreateProposal" method="post">
    <div class="form-group">
        <label for="Name">Nazwa gry</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Genre">Gatunek</label>
        <input asp-for="Genre" class="form-control" />
        <span asp-validation-for="Genre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Description">Opis gry</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Wyślij propozycję</button>
</form>

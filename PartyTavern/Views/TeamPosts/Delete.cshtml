@model PartyTavern.Models.TeamPost

@{
    ViewData["Title"] = "Usuń posta";
}

<h1>@ViewData["Title"]</h1>

<h3>Na pewno chcesz usunąć posta?</h3>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Tak, usuń</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Anuluj</a>
</form>

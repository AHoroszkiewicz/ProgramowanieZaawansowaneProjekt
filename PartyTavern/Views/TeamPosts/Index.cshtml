@model IEnumerable<PartyTavern.Models.TeamPost>

@{
    ViewData["Title"] = "Drużyny";
    var currentUserId = ViewData["CurrentUserId"] as string; // Pobieramy ID użytkownika
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>Gra</th>
            <th>Rozmiar drużyny</th>
            <th>Opis</th>
            <th>Termin gry</th>
            <th>Członkowie drużyny</th> <!-- Dodana kolumna do wyświetlania członków -->
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model)
        {
            <tr>
                <td>@post.Game.Name</td>
                <td>@post.CurrentTeamSize/@post.TeamSize</td>
                <td>@post.Description</td>
                <td>@post.NeededBy.ToString("g")</td>
                <td>
                    @* Wyświetlanie członków drużyny (użytkowników powiązanych z TeamMember) *@
                    @foreach (var tm in post.TeamMembers)
                    {
                        <div>
                            @tm.User.UserName <!-- Wyświetlamy tylko nazwę użytkownika -->
                        </div>
                    }

                    @* Dodaj przycisk Dołącz tylko jeśli drużyna nie jest pełna i użytkownik nie jest już w drużynie *@
                    @if (post.CurrentTeamSize < post.TeamSize && !post.TeamMembers.Any(tm => tm.UserId == currentUserId))
                    {
                        <form method="post" asp-action="Join" asp-route-postId="@post.Id">
                            <button type="submit" class="btn btn-primary">Dołącz</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Drużyna pełna, lub już dołączono</span>
                    }

                    @* Dodaj przycisk Edytuj tylko dla twórcy posta lub administratora *@
                    @if (post.UserId == currentUserId || User.IsInRole("Admin"))
                    {
                        <a href="@Url.Action("Edit", "TeamPosts", new { id = post.Id })" class="btn btn-secondary">Edytuj</a>
                    }

                    @* Dodaj przycisk Usuń tylko dla twórcy posta lub administratora *@
                    @if (post.UserId == currentUserId || User.IsInRole("Admin"))
                    {
                        <a href="@Url.Action("Delete", "TeamPosts", new { id = post.Id })" class="btn btn-danger">Usuń</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Stwórz nową drużynę!</a>

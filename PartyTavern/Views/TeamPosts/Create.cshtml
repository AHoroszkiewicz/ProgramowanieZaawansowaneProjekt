@model PartyTavern.Models.TeamPost

@{
    ViewData["Title"] = "Stwórz nową drużynę!";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="GameId">Wybierz grę:</label>
        <select asp-for="GameId" asp-items="@(new SelectList(ViewBag.Games, "Id", "Name"))" class="form-control">
            <option value="">-- Wybierz grę --</option>
        </select>
        <span asp-validation-for="GameId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TeamSize" class="control-label">Rozmiar drużyny:</label>
        <input asp-for="TeamSize" class="form-control" />
        <span asp-validation-for="TeamSize" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label">Opis:</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NeededBy" class="control-label">Termin gry:</label>
        <input asp-for="NeededBy" class="form-control" type="datetime-local" />
        <span asp-validation-for="NeededBy" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Stwórz!</button>
</form>
